<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- net8 Microsoft.AspNetCore.OpenApi exposes WithOpenApi(), not the net9+ AddOpenApi/MapOpenApi pair. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.32" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- CPU backend must be referenced by the host so native llama.cpp binaries
         are copied next to the API. Do not swap this for a CUDA package. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrainLoop.Core\TrainLoop.Core.csproj" />
    <ProjectReference Include="..\TrainLoop.Infrastructure\TrainLoop.Infrastructure.csproj" />
    <ProjectReference Include="..\TrainLoop.Llm\TrainLoop.Llm.csproj" />
  </ItemGroup>

</Project>
